# Copy to .env.homologation and replace only placeholders with synthetic/local secrets.
# This file is deliberately not a production configuration.
COMPOSE_PROJECT_NAME=lead-finder-homologation
PILOT_HOMOLOGATION=true
NODE_ENV=homologation
POSTGRES_DB=leadfinder_homologation
POSTGRES_USER=leadfinder_homologation
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_HOMOLOGATION_SECRET
DATABASE_URL=postgresql://leadfinder_homologation:REPLACE_WITH_URL_ENCODED_LOCAL_HOMOLOGATION_SECRET@postgres:5432/leadfinder_homologation
PILOT_DATABASE_GUARD=leadfinder_homologation
PILOT_RESTORE_DB=leadfinder_homologation_restore
API_PORT=3001
API_AUTH_TOKEN=REPLACE_WITH_A_32_CHARACTER_MINIMUM_LOCAL_HOMOLOGATION_TOKEN
API_AUTH_PERMISSIONS=pilot:read,pilot:write,pilot:review,pilot:record-contact,pilot:record-result
API_BATCH_PROCESSING_ENABLED=false
DRY_RUN=true
SHADOW_MODE_ENABLED=true
# false is required for API/worker startup; use the controlled script to engage it during incidents.
PILOT_KILL_SWITCH_ENABLED=false
# The operator test is a separate closed flow and remains disabled by default.
OPERATOR_TEST_ENABLED=false
OPERATOR_TEST_KILL_SWITCH_ENABLED=true
OPERATOR_TEST_WHATSAPP_E164=
OPERATOR_TEST_FINGERPRINT_KEY=
OPERATOR_TEST_RECIPIENT_BINDING_KEY=
# Enable only for a single, time-bounded internal operator run.
HML_OPERATOR_AUTH_ENABLED=false
HML_OPERATOR_AUTH_TOKEN_HASH=
HML_OPERATOR_AUTH_EXPIRES_AT=
HML_OPERATOR_AUTH_PRINCIPAL_ID=
# Cloud API remains disabled until a separate, time-bounded HML approval.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_TEST_RECIPIENT=
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_MAX_SENDS=1
# The email test is operator-only, self-addressed, and disabled by default.
OPERATOR_EMAIL_TEST_ENABLED=false
OPERATOR_EMAIL_TEST_KILL_SWITCH_ENABLED=true
OPERATOR_EMAIL_TEST_RECIPIENT=
OPERATOR_EMAIL_TEST_SENDER=
OPERATOR_EMAIL_TEST_SMTP_USER=
OPERATOR_EMAIL_TEST_SMTP_APP_PASSWORD=
OPERATOR_EMAIL_TEST_FINGERPRINT_KEY=
REAL_SEND_ENABLED=false
REAL_PROVIDERS_ENABLED=false
REAL_PROVIDER_CONFIGURED=false
COLLECTION_EGRESS_ENABLED=false
ENABLE_N8N=false
PILOT_EXTERNAL_PROCESSING_ENABLED=false
AUTHENTICATED_COLLECTION_ENABLED=false
AUTOMATED_SENDING_ENABLED=false
WEBHOOKS_ENABLED=false
WHATSAPP_AUTOMATION_ENABLED=false
EMAIL_SENDING_ENABLED=false
SMS_SENDING_ENABLED=false
CAMPAIGN_EXTERNAL_CALLS_ENABLED=false
PILOT_BACKUP_DIR=/opt/lead-finder-homologation/backups
PILOT_EVIDENCE_DIR=/opt/lead-finder-homologation/evidence
