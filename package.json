{
  "name": "lead-finder-sem-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:pii-contracts": "vitest run --config vitest.pii-contracts.config.ts --coverage",
    "test:integration": "tsx scripts/migration-0010-upgrade-test.ts && tsx scripts/migration-0012-pilot-integrity-test.ts && tsx scripts/integration-test.ts",
    "test:batch-gate": "tsx scripts/batch-synthetic-gate.integration.ts",
    "mock:overpass": "tsx scripts/mock-overpass.ts",
    "format": "prettier --write .",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "operator:whatsapp": "tsx scripts/manual-whatsapp-console.ts",
    "operator:test:whatsapp": "tsx scripts/operator-test-console.ts",
    "test:pilot": "tsx scripts/integration-test.ts",
    "test:pilot:restart": "tsx scripts/pilot-restart-test.ts",
    "pilot:real:preflight": "tsx scripts/pilot-real-preflight.ts",
    "pilot:real:fixture": "tsx scripts/pilot-real-synthetic-batch.ts",
    "pilot:real:log-privacy": "tsx scripts/pilot-real-log-privacy.ts",
    "restore:suppression:export": "tsx scripts/restore-suppression/cli.ts export",
    "restore:suppression:validate": "tsx scripts/restore-suppression/cli.ts validate",
    "restore:suppression:apply": "tsx scripts/restore-suppression/cli.ts apply",
    "restore:suppression:verify": "tsx scripts/restore-suppression/cli.ts verify",
    "test:restore-suppression": "tsx scripts/restore-suppression.integration.ts",
    "test:persisted-pii-audit": "tsx scripts/persisted-pii-audit-json.integration.ts",
    "test:supabase-data-api-security": "tsx scripts/supabase-data-api-security.integration.ts && tsx scripts/manual-messaging-append-only-acl.integration.ts && npm run test:persisted-pii-audit",
    "test:manual-messaging": "tsx scripts/manual-messaging.integration.ts && tsx scripts/manual-messaging-concurrency.integration.ts && tsx scripts/operator-channel-test.integration.ts",
    "test:operator-channel": "tsx scripts/operator-channel-test.integration.ts",
    "test:migration-registry": "tsx scripts/migration-registry-compatibility.integration.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "zod": "^3.25.67"
  }
}
