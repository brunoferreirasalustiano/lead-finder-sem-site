NODE_ENV=development
API_PORT=3000
API_AUTH_TOKEN=CHANGE_ME
API_AUTH_PERMISSIONS=pilot:read,pilot:write,pilot:review,pilot:record-contact,pilot:record-result
PROSPECTING_METRICS_ENABLED=false
DATABASE_URL=postgresql://leadfinder:change-me@localhost:5432/leadfinder
POSTGRES_DB=leadfinder
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me
COLLECTION_EGRESS_ENABLED=false
OVERPASS_API_URL=
OVERPASS_TIMEOUT_MS=30000
OVERPASS_MAX_RETRIES=3
DEFAULT_CITY=Campinas
DEFAULT_STATE=SP
DEFAULT_COUNTRY=Brasil
DAILY_LEAD_LIMIT=60
WORKER_POLL_INTERVAL_MS=60000
# Shadow mode is isolated to the homologation template by the pilot preflight.
SHADOW_MODE_ENABLED=false
# false allows local startup; engage immediately during incidents or before freezing the environment.
PILOT_KILL_SWITCH_ENABLED=false
# Operator test stays disabled and independently kill-switched until a controlled local test.
OPERATOR_TEST_ENABLED=false
OPERATOR_TEST_KILL_SWITCH_ENABLED=true
# Private values belong only in an untracked local environment or hosted secret manager.
OPERATOR_TEST_WHATSAPP_E164=
OPERATOR_TEST_FINGERPRINT_KEY=
OPERATOR_TEST_RECIPIENT_BINDING_KEY=
# HML-only human confirmation operator; disabled outside an isolated HML run.
HML_OPERATOR_AUTH_ENABLED=false
HML_OPERATOR_AUTH_TOKEN_HASH=
HML_OPERATOR_AUTH_EXPIRES_AT=
HML_OPERATOR_AUTH_PRINCIPAL_ID=
OPERATOR_EMAIL_TEST_ENABLED=false
OPERATOR_EMAIL_TEST_KILL_SWITCH_ENABLED=true
OPERATOR_EMAIL_TEST_RECIPIENT=
OPERATOR_EMAIL_TEST_SENDER=
OPERATOR_EMAIL_TEST_GOOGLE_CLIENT_ID=
OPERATOR_EMAIL_TEST_GOOGLE_CLIENT_SECRET=
OPERATOR_EMAIL_TEST_GOOGLE_REFRESH_TOKEN=
OPERATOR_EMAIL_TEST_FINGERPRINT_KEY=
HML_SUPPRESSION_PROBE_ENABLED=false
CAMPAIGN_DAILY_LIMIT_EMAIL=60
CAMPAIGN_DAILY_LIMIT_WHATSAPP=60
CAMPAIGN_WINDOW_START_UTC=08:00
CAMPAIGN_WINDOW_END_UTC=18:00
CAMPAIGN_MIN_SPACING_MS=1000
OUTBOX_RETRY_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# Dual deployment (safe defaults; secrets intentionally blank)
DEPLOYMENT_PROFILE=oracle-vps
PORT=3000
LOG_LEVEL=info
DIRECT_DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
INTERNAL_CRON_SECRET=
# Keep the web process unable to mutate batch/outbox state unless explicitly approved.
API_BATCH_PROCESSING_ENABLED=false
CRON_AUTH_AUDIENCE=lead-finder-batch
PUBLIC_API_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
LEAD_BATCH_SIZE=5
PROCESSING_TIME_BUDGET_MS=45000
PROCESSOR_ROLE=standby
PROCESSOR_LEASE_MS=60000
DRY_RUN=true
REAL_SEND_ENABLED=false
REAL_PROVIDERS_ENABLED=false
REAL_PROVIDER_CONFIGURED=false
MANUAL_MESSAGING_ENABLED=true
CONTACT_RESOLUTION_KILL_SWITCH_ENABLED=false
CONTACT_RESOLUTION_MODE=LOCAL_MANUAL
CONTACT_RESOLUTION_NO_PROVIDER_MODE=true
CONTACT_RESOLVER_DATABASE_URL=postgresql://lead_finder_contact_resolver_runtime:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/lead_finder
