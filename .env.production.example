POSTGRES_DB=leadfinder
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=GENERATE_A_STRONG_RANDOM_SECRET
DATABASE_URL=postgresql://leadfinder:GENERATE_A_URL_ENCODED_STRONG_RANDOM_SECRET@postgres:5432/leadfinder
API_PORT=3000
API_AUTH_TOKEN=CHANGE_ME
API_AUTH_PERMISSIONS=pilot:read,pilot:write,pilot:review,pilot:record-contact,pilot:record-result
DEPLOY_MODE=tunnel
ENABLE_N8N=false
COLLECTION_EGRESS_ENABLED=false
OVERPASS_API_URL=
OVERPASS_TIMEOUT_MS=30000
OVERPASS_MAX_RETRIES=3
WORKER_POLL_INTERVAL_MS=60000
DRY_RUN=true
# Shadow mode is reserved for the isolated homologation template.
SHADOW_MODE_ENABLED=false
# Production example remains stopped until an explicit controlled release.
PILOT_KILL_SWITCH_ENABLED=true
OPERATOR_TEST_ENABLED=false
OPERATOR_TEST_KILL_SWITCH_ENABLED=true
OPERATOR_TEST_WHATSAPP_E164=
OPERATOR_TEST_FINGERPRINT_KEY=
OPERATOR_TEST_RECIPIENT_BINDING_KEY=
REAL_SEND_ENABLED=false
REAL_PROVIDERS_ENABLED=false
REAL_PROVIDER_CONFIGURED=false
CAMPAIGN_DAILY_LIMIT_EMAIL=100
CAMPAIGN_DAILY_LIMIT_WHATSAPP=100
CAMPAIGN_WINDOW_START_UTC=08:00
CAMPAIGN_WINDOW_END_UTC=18:00
CAMPAIGN_MIN_SPACING_MS=1000
OUTBOX_RETRY_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
DAILY_LEAD_LIMIT=50
API_DOMAIN=api.DOMINIO_EXEMPLO
N8N_DOMAIN=automacao.DOMINIO_EXEMPLO
N8N_ENCRYPTION_KEY=GENERATE_A_STRONG_RANDOM_SECRET
ACME_EMAIL=admin@DOMINIO_EXEMPLO
CADDYFILE_PATH=./deploy/Caddyfile.api.example
BACKUP_DIR=/opt/lead-finder/backups
BACKUP_RETENTION_DAYS=7
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
DEPLOY_USER=leadfinder-deploy
